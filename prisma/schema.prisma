generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  password     String
  name         String
  phone        String?
  address      String?
  avatarUrl    String?
  points       Int           @default(0)
  membershipTier String      @default("Bronze")
  role         UserRole      @default(CUSTOMER)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  chatMessages ChatMessage[]
  rentals      Rental[]
  reviews      Review[]

  @@map("users")
}

model Motorbike {
  id           String          @id @default(uuid())
  name         String
  type         MotorbikeType
  pricePerDay  Decimal         @db.Decimal(10, 2)
  description  String?
  status       MotorbikeStatus @default(AVAILABLE)
  licensePlate String          @unique
  year         Int?
  images       String[]
  fuelCapacity String?
  engineSize   String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  rentals      Rental[]
  reviews      Review[]

  @@index([type])
  @@index([status])
  @@index([pricePerDay])
  @@map("motorbikes")
}

model Rental {
  id             String       @id @default(uuid())
  userId         String
  motorbikeId    String
  startDate      DateTime
  endDate        DateTime
  pickupLocation String
  returnLocation String
  status         RentalStatus @default(PENDING)
  totalPrice     Decimal      @db.Decimal(10, 2)
  numberOfDays   Int
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  payments       Payment?
  motorbike      Motorbike    @relation(fields: [motorbikeId], references: [id])
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  review         Review?

  @@index([userId])
  @@index([motorbikeId])
  @@index([status])
  @@index([startDate])
  @@index([endDate])
  @@map("rentals")
}

model Payment {
  id              String        @id @default(uuid())
  rentalId        String        @unique
  amount          Decimal       @db.Decimal(10, 2)
  method          PaymentMethod
  status          PaymentStatus @default(PENDING)
  transactionId   String?       @unique
  transactionDate DateTime?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  rental          Rental        @relation(fields: [rentalId], references: [id], onDelete: Cascade)

  @@index([rentalId])
  @@index([status])
  @@index([transactionDate])
  @@map("payments")
}

model Review {
  id          String    @id @default(uuid())
  rentalId    String    @unique
  userId      String
  motorbikeId String
  rating      Int
  comment     String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  motorbike   Motorbike @relation(fields: [motorbikeId], references: [id])
  rental      Rental    @relation(fields: [rentalId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([motorbikeId])
  @@index([rating])
  @@map("reviews")
}

model ChatMessage {
  id        String   @id @default(uuid())
  userId    String?
  message   String
  response  String
  isAI      Boolean  @default(true)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([createdAt])
  @@map("chat_messages")
}

model ChatbotConfig {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("chatbot_configs")
}

model Blog {
  id          String   @id @default(uuid())
  title       String
  description String?
  content     String
  image       String
  tag         String?
  author      String?  @default("Admin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("blogs")
}

model Promotion {
  id              String       @id @default(uuid())
  title           String
  description     String
  code            String       @unique
  discountType    DiscountType @default(PERCENTAGE)
  discountValue   Int          @default(0)
  minOrderValue   Decimal      @default(0) @db.Decimal(10, 2)
  image           String
  badge           String?
  startDate       DateTime?
  endDate         DateTime?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@map("promotions")
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum UserRole {
  CUSTOMER
  ADMIN
}

enum MotorbikeType {
  MANUAL
  SCOOTER
  SEMI_AUTO
}

enum MotorbikeStatus {
  AVAILABLE
  RENTED
  MAINTENANCE
  UNAVAILABLE
}

enum RentalStatus {
  PENDING
  CONFIRMED
  ONGOING
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  E_WALLET
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}
